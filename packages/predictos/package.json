{
  "name": "predictos",
  "version": "0.1.0",
  "description": "PredictOS 'Super Intelligence' core (prediction-market multi-agent analysis, data clients, and cross-platform arbitrage) adapted from PredictionXBT/PredictOS, refactored from Deno/Supabase edge functions into Node/TypeScript ESM.",
  "license": "MIT",
  "author": "PredictionXBT (original); adapted for the investing package",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/qwksearch-research-agent.git",
    "directory": "packages/predictos"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.mjs",
      "require": "./dist/ai/index.js"
    },
    "./data/kalshi": {
      "types": "./dist/data/kalshi.d.ts",
      "import": "./dist/data/kalshi.mjs",
      "require": "./dist/data/kalshi.js"
    },
    "./data/polymarket": {
      "types": "./dist/data/polymarket.d.ts",
      "import": "./dist/data/polymarket.mjs",
      "require": "./dist/data/polymarket.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.mjs",
      "require": "./dist/agents/index.js"
    },
    "./arbitrage": {
      "types": "./dist/arbitrage.d.ts",
      "import": "./dist/arbitrage.mjs",
      "require": "./dist/arbitrage.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "prediction-markets",
    "polymarket",
    "kalshi",
    "arbitrage",
    "trading-agents",
    "grok",
    "openai",
    "predictos"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@polymarket/clob-client": "5.1.3",
    "ethers": "^6.16.0"
  },
  "optionalDependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "terser": "^5.49.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.0.0"
  }
}
